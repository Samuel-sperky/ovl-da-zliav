{
  "name": "ovl-da-zliav",
  "version": "0.1.0",
  "private": true,
  "description": "Aura Zľavy — lokálny nástroj na časovo obmedzené percentuálne zľavy (max 10 produktov)",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:build": "vitest run --config vitest.smoke.config.ts",
    "e2e": "playwright test",
    "migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.ts",
    "gen-master-key": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-master-key.ts",
    "seed-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-admin.ts",
    "check-compose-bind": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-compose-bind.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "argon2": "^0.45.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.8",
    "mariadb": "^3.5.3",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
