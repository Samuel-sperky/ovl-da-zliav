# Aura Zľavy — .gitignore
# Invariant I1: žiadne tajomstvo sa NESMIE dostať do repozitára.

# Tajomstvá a kľúče (I1, D61, D89, D97)
.env
.env.*
!.env.example
secrets/
*.key
*.hash
*.pem
*.crt

# Zálohy (D90) — obsahujú DB dump
backups/

# Node / Next
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Testy a nástroje
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Editory a OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logy
*.log
npm-debug.log*

# Vizuálne snímky UI — generovaný artefakt (Playwright proti mock shopu),
# nie zdroj. Regenerujú sa na požiadanie, do repa nepatria (2,5 MB a starnú).
/screenshots/

# Statický snímkovač (`npm run snimky`) — PNG obrazoviek aj zabalená stránka,
# z ktorej vznikli. Obrázky do repozitára nepatria; vyrobia sa jedným príkazom.
/snimky/

# Živý lokálny override je strojovo špecifický — v repe žijú len *.example.yml (R1w).
docker-compose.override.yml

# Renderované PNG a ZIP dodávky návrhu — generované z design/mockups/,
# do repa nepatria (binárne, znovuvytvoriteľné).
design/png/
*.zip

# Plný export katalógu do e2e fixture (scripts/export-catalog-fixture.sh).
# 41 220 názvov produktov z produkčného eshopu, ~5,9 MB — generovateľné
# z bežiacej DB, do repa nepatrí. V gite žije len reálna vzorka 500 riadkov
# (katalog-vzorka.ndjson), aby e2e prešlo aj bez databázy.
test/e2e/fixtures/katalog.ndjson
