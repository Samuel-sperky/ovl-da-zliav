# Aura Zľavy — vzor ENV (BUILD-SPEC §11)
#
# INVARIANT I1: v tomto súbore NESMIE byť žiadne tajomstvo — ani API kľúč shopu,
# ani DB heslo, ani master key. Heslá sa čítajú zo SÚBOROV (`*_FILE`), tajomstvá
# žijú v `secrets/` mimo gitu.
#
# INVARIANT I5/I14: `PUBLIC_BIND` musí byť 127.0.0.1, inak appka pri boote skončí.
#
# POZOR: doména shopu NIE JE ENV premenná — zadáva sa v UI a žije
# v `settings.shop_domain` (R5, D80). Do repa sa nesmie dostať.

# ── Runtime a poistky zápisu (D77, I13) ──────────────────────────────────────
NODE_ENV=development
# Ostrý zápis prebehne LEN pri NODE_ENV=production A WRITES_ENABLED=true.
WRITES_ENABLED=false
PUBLIC_BIND=127.0.0.1
PORT=3000
APP_VERSION=0.1.0

# ── Databáza (D89) ───────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ovl_zliav
DB_USER=ovl_zliav_app
DB_PASSWORD_FILE=/run/secrets/db_app_password
DB_MIGRATION_USER=ovl_zliav_mig
DB_MIGRATION_PASSWORD_FILE=/run/secrets/db_mig_password
# DB_PASSWORD / DB_MIGRATION_PASSWORD sú povolené VÝHRADNE mimo produkcie
# (lokálny vývoj a CI). V produkcii je ich prítomnosť fail-fast chyba.
# DB_PASSWORD=
# DB_MIGRATION_PASSWORD=

# ── Tajomstvá zo súborov (D61, D69, O2) ──────────────────────────────────────
# 32 B náhodných dát, chmod 400, vlastník = uid appky. Generuje
# `npm run gen-master-key`. NIKDY nie v obraze ani v env premennej.
MASTER_KEY_FILE=/run/secrets/master.key
SESSION_SECRET_FILE=/run/secrets/session.key

# ── Kľúč shopu, session, sudo, lockout (R2, D69, D70, D71) ───────────────────
# TTL kľúča: maximum 48, vyššia hodnota je chyba konfigurácie.
API_KEY_TTL_HOURS=48
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=30
SUDO_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ── Scheduler (D32, D82, D87) ────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=60000
SCHEDULER_FIRE_TIME=00:05
LOGIC_TIMEZONE=Europe/Bratislava

# ── Shop API klient (D42–D46) ────────────────────────────────────────────────
SHOP_TIMEOUT_READ_MS=10000
SHOP_TIMEOUT_WRITE_MS=30000
SHOP_WRITE_PAUSE_MS=250
SHOP_RETRY_MAX=3
SHOP_RETRY_AFTER_CAP_S=90

# ── Predajnosť z objednávok (KONTRAKT-PREDAJNOST-2026-08-06) ─────────────────
# Druhý kľúč shopu (`orders:read`) je LEN na čítanie a nevidí osobné údaje,
# preto má vlastnú, dlhšiu platnosť než 48 h zápisového kľúča (P2).
ORDERS_KEY_TTL_DAYS=30
SALES_SYNC_ENABLED=true
# Okno predajov. POZOR: zoznam objednávok nevracia položky, takže product-level
# predaje stoja JEDEN REQUEST NA JEDNU OBJEDNÁVKU. Zmerané 6.8.2026: 3 dni =
# 978 objednávok, 90 dní by bolo ~29 000 requestov na produkčný shop.
# Strop je od 3.9.2026 360 dní (D149 — prepínač okna toľko ponúka), ale je to
# DOVOLENIE, nie plán: 360 dní je ~118 000 requestov a dráha `orders` má 800
# čítaní na UTC deň, teda rádovo mesiace. Beh navyše ide od NAJSTARŠIEHO dňa,
# takže skok na 360 nad prázdnou históriou pozastaví aj obnovu dneška.
# Rozširuj po malých krokoch a sleduj `sales_sync_state` (viď docs/21 R1).
SALES_WINDOW_DAYS=3
# Strop na JEDEN beh synchronizácie. Po dosiahnutí sa beh korektne ukončí,
# uloží pokrok a pokračuje nabudúce — nikdy neblokuje zľavy (P6).
ORDERS_MAX_REQUESTS_PER_RUN=1500
# Minimum je 250 ms: requesty idú sekvenčne, takže najhorší prípad je
# 60000/ORDERS_PAUSE_MS za minútu a shop dovoluje 300/60 s na kľúč.
ORDERS_PAUSE_MS=250

# ── Stropy (I2, D79, D59) ────────────────────────────────────────────────────
# MAX_PRODUCTS_PER_OPERATION a ALLOWLIST_MAX majú tvrdý strop 10 (I2).
MAX_PRODUCTS_PER_OPERATION=10
ALLOWLIST_MAX=10
RUNAWAY_LIMIT_PER_HOUR=60
MIDNIGHT_FREEZE_SECONDS=60

# ── Logovanie (D92) ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Testy (I6) ───────────────────────────────────────────────────────────────
# Presmerovanie na mock shop. Povolené VÝHRADNE keď NODE_ENV != production;
# v produkcii je jeho prítomnosť fail-fast chyba.
# SHOP_BASE_URL_OVERRIDE=http://127.0.0.1:0
