# ─────────────────────────────────────────────────────────────
#  Aura Zľavy (ovl-da-zliav) — vzorové prostredie
#  Skopíruj do .env a vyplň.  .env NIKDY nekomituj do gitu.
# ─────────────────────────────────────────────────────────────

APP_NAME="Aura Zľavy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:3050

# Jazyk UI = slovenčina; časové pásmo eshopu pre okná zliav
APP_LOCALE=sk
APP_FALLBACK_LOCALE=sk
APP_FAKER_LOCALE=sk_SK
APP_TIMEZONE=UTC
SHOP_TIMEZONE=Europe/Bratislava

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Databáza ─────────────────────────────────────────────────
# Produkcia / PC: MariaDB v kontajneri ovl-zliav-db.
DB_CONNECTION=mariadb
DB_HOST=ovl-zliav-db
DB_PORT=3306
DB_DATABASE=ovl_zliav
DB_USERNAME=ovl
DB_PASSWORD=zmen-ma
# Pozn.: pre lokálny vývoj bez MariaDB nastav DB_CONNECTION=sqlite
# a vytvor database/database.sqlite (appka je DB-agnostická).

# ── Session / cookie ─────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Beh na plain http://127.0.0.1 → Secure cookie VYPNUTÝ,
# kompenzované Host/Origin kontrolou (middleware).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── E-mail (zhrnutia a alerty schedulera) ───────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="aura-zlavy@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ── SPERKY API ───────────────────────────────────────────────
SPERKY_BASE_URL=https://sperky-eshop.sk
# Kľúč so scope product:edit + product:read + orders:read.
# Zadáva sa cez onboarding formulár; appka ho zapíše sem a sama NEMAŽE.
SPERKY_API_KEY=
SPERKY_TIMEOUT_CONNECT=5
SPERKY_TIMEOUT_REQUEST=15
SPERKY_MAX_RETRIES=3

# ── Operátor (jeden lokálny účet) ────────────────────────────
# Bcrypt hash hesla operátora (vygeneruj: php artisan ovl:hash-password).
OPERATOR_PASSWORD_HASH=

# ── Prevádzkové poistky (default; prepísateľné v UI → settings) ─
OVL_BATCH_CAP=200
OVL_DAILY_CAP=500
OVL_MIN_MARGIN_PERCENT=15
OVL_CONFIRM_THRESHOLD=50
OVL_CONFIRM_WORD=POTVRDZUJEM
OVL_RATE_RESERVE_PER_MIN=10
OVL_RETENTION_DAYS=90
OVL_DRIFT_TOLERANCE_PERCENT=1
OVL_KILL_SWITCH=false
