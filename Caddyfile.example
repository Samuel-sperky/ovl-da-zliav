# Aura Zľavy — Caddyfile PRÍKLAD (D94, D95).
#
# Repo obsahuje LEN tento example (I1). Reálny súbor žije v `secrets/Caddyfile`
# (mimo gitu). Postup: docs/21-RUNBOOKY.md.
#
# 27. 8. 2026 (D98) z tohto súboru zmizol blok `basic_auth`, a s ním aj heslo,
# bcrypt hash a `secrets/basicauth.hash`. Kópia je odteraz doslovná:
#   cp Caddyfile.example secrets/Caddyfile
# a nič sa v nej nedopĺňa. To isté robí `scripts/setup-local.sh` (alebo `.ps1`
# na Windows).

{
  admin off
  # ak by sa v budúcnosti pridal reverse proxy/tunel, doplniť:
  # servers { trusted_proxies static private_ranges }
}

# HTTP bez TLS — vedomé rozhodnutie Samuela (6.8.2026, odchýlka od D94):
# appka beží výhradne na 127.0.0.1, TLS s lokálnou CA robil viac trenia než
# úžitku (neznámy cert, trust root). Od 27. 8. 2026 (D99) tu nie je ani session
# cookie — jedinou ochranou pred sieťou je I5: publikovaný je len
# 127.0.0.1:3070, nič viac.
#
# Explicitná schéma http:// vypína automatické HTTPS aj presmerovania.
#
# ZMENA PORTU: číslo musí sedieť na DVOCH miestach — tu (obe adresy) a
# v `docker-compose.yml` (`127.0.0.1:PORT:PORT` pri ovl-zliav-caddy). Strážny
# test `test/unit/compose-bind.spec.ts` a `scripts/check-compose-bind.ts` majú
# port zapísaný tiež — je to zámer, nech sa port nedá zmeniť omylom (I5).
http://localhost:3070, http://127.0.0.1:3070 {

  # `basic_auth` ZRUŠENÉ 27. 8. 2026 (D98, ruší D97). Bola to tretia vrstva
  # prihlásenia pred appkou, ktorá mala vlastnú bránu; nechránila nič, čo
  # nechráni I5 (publikovaný je len 127.0.0.1:3070). Žiadny bcrypt hash sa už
  # negeneruje a `secrets/basicauth.hash` neexistuje. Dôvod a prijaté riziko:
  # KONTRAKT-BEZ-LOGINU-2026-08-27.md.

  header {                                       # D95
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    # HSTS vypnuté — platí len pre HTTPS; na HTTP by bol mätúci šum.
    -Server
  }

  encode gzip
  reverse_proxy ovl-zliav-app:3000
}
